# GEMINI_API_KEY: Declared by the AI Studio scaffolding / metadata.json.
# AI Studio automatically injects this at runtime from user secrets.
# NOTE: the server makes no Gemini API call today.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Declared for self-referential links / OAuth callbacks by scaffolding.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# NOTE: not referenced by the current server.
APP_URL="MY_APP_URL"

# GOOGLE_SHEETS_WEBHOOK_URL: Google Apps Script web app URL (or Zapier/Make webhook).
# If set, every application is POSTed here (non-blocking) after being saved locally
# to data/applications.json. If empty, the forward is skipped with a log line.
GOOGLE_SHEETS_WEBHOOK_URL=""
